{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "eslint-plugin-cadence"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w cadence-web",
    "dev:api": "npm run dev -w cadence-api",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:web": "eslint \"apps/web/**/*.{ts,tsx,js,jsx}\"",
    "lint:api": "eslint \"apps/api/**/*.{ts,tsx,js,jsx}\" --ignore-pattern \"apps/api/src/generated/**\"",
    "lint:fix": "eslint . --fix",
    "test:web": "npm test -w cadence-web",
    "test:api": "npm test -w cadence-api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "fix:em-dash": "node scripts/fix-em-dash.mjs",
    "prepare": "node ./scripts/prepare-husky.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-cadence": "*",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  },
  "lint-staged": {
    "*": [
      "node scripts/fix-em-dash.mjs"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
