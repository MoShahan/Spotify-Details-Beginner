# TiDB Cloud Starter (MySQL) - from Connect → Prisma
# Use your app DB name in the path (e.g. /cadence), not /sys
DATABASE_URL=

# Auth
JWT_SECRET=
# Optional - default 7d
JWT_EXPIRES_IN=7d

# ImageKit (API only for private key)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# CDN base only - do NOT append a media folder (e.g. https://ik.imagekit.io/your_id)
IMAGEKIT_URL_ENDPOINT=
# Upload destination in the media library (seed + client uploads use this)
IMAGEKIT_FOLDER=/cadence

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
