# TiDB Cloud Starter (MySQL) - from Connect → Prisma
# Use your app DB name in the path (e.g. /cadence), not /sys
DATABASE_URL=

# Auth
JWT_SECRET=
# Optional - default 7d
JWT_EXPIRES_IN=7d

# ImageKit (API only for private key)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
